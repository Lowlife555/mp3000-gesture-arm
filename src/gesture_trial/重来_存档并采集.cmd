@echo off
chcp 65001 >nul
cd /d "%~dp0"
set PY="C:\Users\<you>\venvs\mp3000-nn\Scripts\python.exe"

echo ============================================================
echo   重来第一步：存档旧数据
echo ============================================================
%PY% 01b_archive.py

echo.
echo ============================================================
echo   重来第二步：采集（下面这个窗口的要点）
echo ============================================================
echo   1) 右下角小图 = 模型实际看到的样子，手必须占满它
echo   2) 右上角 box mean/std，std 低于 20 会变橙色并警告
echo   3) 三类交错采：fist 60 -^> palm 60 -^> scissors 60，轮回 3~4 轮
echo      千万不要一类采完再采下一类
echo   4) 按 1/2/3 切类别，空格 开始/停止，q 退出
echo.
echo   采完按 q，脚本会自动打印数据健康检查。
echo   出现任何 [警告] = 先别训练，重新采。
echo ============================================================
pause

%PY% 01_capture.py

echo.
echo ============================================================
echo   采集结束。
echo   如果上面出现 [警告]，先别训练，双击本文件重来一遍。
echo   如果全绿，双击 训练.cmd
echo ============================================================
pause
